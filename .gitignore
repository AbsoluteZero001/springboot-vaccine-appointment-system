# ============================================================
# .gitignore — 仓库根目录即项目根目录
# 技术栈：Spring Boot 3 (Maven) + Vue 3 (Vite) + Docker
# ============================================================

### Maven / Java 构建产物 ###
target/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar
HELP.md

### 前端构建产物与依赖 ###
node_modules/
frontend/node_modules/
frontend/dist/
*.vite/
frontend-dist/
dist/
out/
bin/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### 单体 JAR 内嵌的前端静态资源（由 Vite 构建生成）###
src/main/resources/static/assets/
src/main/resources/static/index.html

### 发布打包目录 ###
/release/

### Spring 本地配置 ###
src/main/resources/application-local.yml
src/main/resources/application-*.yml
!src/main/resources/application.yml
!src/main/resources/application-dev.yml
!src/main/resources/application-prod.yml
src/main/resources/application-*.properties
!src/main/resources/application.properties

### 环境变量与密钥（仅保留 .example 模板）###
.env
.env.*
!.env.example
docker-compose.override.yml

### 用户上传目录与运行日志 ###
uploads/
logs/
*.log

### 第三方依赖目录 ###
lib/
vendor/

### IntelliJ IDEA ###
.idea/
*.iml
*.iws
*.ipr

### Eclipse / STS ###
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

### NetBeans ###
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/

### AI 工具本地目录 ###
.claude/

### 备份 / 临时 / 合并冲突文件 ###
*.bak
*.backup
*.backup*
*.tmp
*.temp
*.swp
*.swo
*~
*.orig

### 操作系统文件 ###
.DS_Store
Thumbs.db
desktop.ini
